{
  "manifest_version": 3,
  "name": "ShowMeWise: record, guide, chat",
  "short_name": "ShowMeWise",
  "version": "1.1.0",
  "description": "Record your screen and get a step-by-step guide. Chat with your videos, documents and the page you are on. Runs on your computer.",
  "homepage_url": "https://showmewise.netlify.app/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open ShowMeWise",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "panel.html?popup=1"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "sidePanel",
    "desktopCapture",
    "notifications",
    "storage",
    "power",
    "scripting",
    "activeTab",
    "system.memory",
    "alarms",
    "offscreen",
    "search",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://showmewise.netlify.app/*",
    "http://127.0.0.1:8899/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://showmewise.netlify.app/*",
        "http://127.0.0.1:8899/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pet/pet3d.html",
        "pet/pet3d.js",
        "pet/three/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
